<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>The_World</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- The test project and the course starters live in subfolders; keep them out
         of this project's compile glob. Each Course/starters/LessonNN_* folder is
         its own standalone project. -->
    <ItemGroup>
        <Compile Remove="TheWorld.Tests/**" />
        <Compile Remove="Course/**" />
    </ItemGroup>

</Project>
